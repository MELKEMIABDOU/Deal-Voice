# Copy this file to .env.docker and never commit the resulting secret file.
HF_TOKEN=

OLLAMA_MODEL_NAME=qwen3:8b
# Local AMD/Windows option: http://host.docker.internal:11434
DEALVOICE_OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_THREAD=4
OLLAMA_KEEP_ALIVE=5m
OLLAMA_REASONING=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

COLLECTION_NAME=enterprise_knowledge
ALLOW_DESTRUCTIVE_SCHEMA_MIGRATION=false
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_VECTOR_SIZE=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

RBAC_ENABLED=false
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_FILES=5
MAX_AUDIO_DURATION_MINUTES=120

# CPU/local Docker profile. The GPU override replaces these values.
WHISPER_MODEL_NAME=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
WHISPER_BATCH_SIZE=1
AUDIO_WORKER_TIMEOUT_SECONDS=3600
AUDIO_WORKER_CPU_THREADS=2
PDF_WORKER_TIMEOUT_SECONDS=1800
PDF_WORKER_CPU_THREADS=2

# Required only with docker-compose.prod.yml.
DEALVOICE_DOMAIN=dealvoice.example.com
DEALVOICE_BASIC_AUTH_USER=client
DEALVOICE_BASIC_AUTH_HASH=
