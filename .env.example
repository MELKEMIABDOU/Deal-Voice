# Copy to .env and fill in local values. Never commit .env.
# Local defaults are conservative. The commented GPU profile targets a 16 GB T4.
OLLAMA_MODEL_NAME=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_THREAD=4
OLLAMA_KEEP_ALIVE=0s
OLLAMA_REASONING=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

QDRANT_STORAGE_PATH=./local_qdrant_db
QDRANT_URL=
QDRANT_API_KEY=
PARENT_DOCSTORE_PATH=./local_qdrant_db/parent_docstore
COLLECTION_NAME=enterprise_knowledge
ALLOW_DESTRUCTIVE_SCHEMA_MIGRATION=false
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_VECTOR_SIZE=1024
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# No built-in authentication: protect remote access at the hosting/proxy layer.
RBAC_ENABLED=false
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_FILES=5
MAX_AUDIO_DURATION_MINUTES=120

# Required for diarization, with access to the gated models used by WhisperX.
HF_TOKEN=
WHISPER_MODEL_NAME=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
WHISPER_BATCH_SIZE=1
# GCP T4 profile (enable all three together):
# WHISPER_MODEL_NAME=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
AUDIO_WORKER_TIMEOUT_SECONDS=3600
AUDIO_WORKER_CPU_THREADS=2
PDF_WORKER_TIMEOUT_SECONDS=1800
PDF_WORKER_CPU_THREADS=2
